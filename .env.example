# Copy to .env.local and fill in.

# OpenAI key. If left empty the app falls back to a deterministic MOCK decider
# (keyword-based) so you can try the whole flow without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Makes the Inngest SDK talk to the local Inngest Dev Server (http://localhost:8288).
# Remove this in production and set INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY instead.
INNGEST_DEV=1
